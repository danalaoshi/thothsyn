# ===== Supabase 自托管配置（来自 `supabase start` 输出 / supabase/.temp 生成的 .env）=====
# 以下为占位，启动 Supabase 后用真实值覆盖（见 README）。

# asyncpg 连接串，指向 Supabase Postgres（默认端口 54322，库名 postgres，角色 postgres）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# GoTrue 签发用户 JWT 的 secret。
# 注意：本地栈 GoTrue 实际用 ES256 签发 access token（经 JWKS 公钥校验）；
# 此 secret 仅作为 HS256 兜底（本地测试伪造 token / 兼容场景）。
SUPABASE_JWT_SECRET=replace-with-real-jwt-secret

# Supabase 网关地址（Kong，本地栈默认 54321）。
# 用于：/api/me 拉取邮箱确认态 + JWKS 公钥校验（/auth/v1/.well-known/jwks.json）。
# 建议用 127.0.0.1 而非 localhost，避免浏览器/容器 IPv6 解析差异。
SUPABASE_URL=http://127.0.0.1:54321

# 公开 anon key 与 service_role key（supabase start 打印）
SUPABASE_ANON_KEY=replace-with-real-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-service-role-key

# 管理员邮箱（逗号分隔）；留空则首个注册用户自动成为 superuser
SUPERUSER_EMAILS=

# 本地邮箱（Mailpit）。`supabase start` 起的 GoTrue 把所有认证邮件投递到这里，
# 不会发到真实邮箱；管理页的「本地邮箱」视图通过后端代理读取。
# 生产环境把 ENV 改为 prod（或 MAIL_PROXY_ENABLED=false）即自动关闭该代理。
MAIL_URL=http://127.0.0.1:54324
MAIL_API_URL=http://127.0.0.1:54324
MAIL_PROXY_ENABLED=true

# 运行参数
ENV=dev
CORS_ORIGINS=*
API_PREFIX=/api
