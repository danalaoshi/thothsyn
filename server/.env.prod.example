# ===== 生产环境（托管 Supabase + PaaS）=====
# 取值自你的 Supabase 项目（supabase.com → Project Settings → API / Database）。
# 复制为 .env.prod 后填入真实值；.env.prod 已被 .gitignore 忽略，不会入库。

# Supabase 数据库连接（Database 页 Connection string → 用 Pooler，端口 6543 或 5432）
# 事务池 6543 / 会话池 5432 均可；引擎已关 statement cache（db.py），两种模式都兼容
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<region>.pooler.supabase.com:6543/postgres

# Supabase 项目地址（用于 JWKS 公钥校验与 /api/me 拉取邮箱确认态）
SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings → API → JWT Secret（HS256 兜底校验用，请勿泄露）
SUPABASE_JWT_SECRET=<your-jwt-secret>

# 公开 anon key 与 service_role key（Project Settings → API）
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# 管理员邮箱（逗号分隔），命中即自动成为 superuser（每次鉴权复查，可自愈）
# 建议填你注册后台时要用的邮箱
SUPERUSER_EMAILS=bayeethmonkey@gmail.com

# 生产环境：关闭本地邮箱代理、禁用首用户引导（避免公网第一个注册者拿管理权）
ENV=prod
MAIL_PROXY_ENABLED=false
BOOTSTRAP_FIRST_SUPERUSER=false

# CORS：上线后建议收紧为你的前端/扩展来源白名单，例如 "https://<你的域名>"
CORS_ORIGINS=*

# 以下本地开发项在生产可留空或删除
MAIL_URL=
MAIL_API_URL=
